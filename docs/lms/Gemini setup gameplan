    print("\n=== RESULTS ===")
    print(f"Characters found: {len(results['entities']['characters'])}")
    print(f"Locations found: {len(results['entities']['locations'])}")
    print(f"Items found: {len(results['entities']['items'])}")
    print(f"Processing time: {results['stats']['total_time']:.1f}s")
    print(f"Estimated cost: ${results['stats']['estimated_tokens'] * 0.00001:.4f}")
