"""
Gemini-powered entity extraction and analysis.
Processes clean chunks from Ollama chunker.
"""
import os
from typing import Dict, List, Optional
import json
import google.generativeai as genai
from dotenv import load_dotenv


class GeminiAnalyzer:
    """Analyzes chunks using Gemini API for entity extraction."""
    
    def __init__(self, model: str = "gemini-1.5-flash"):
        load_dotenv()
        api_key = os.getenv('GEMINI_API_KEY')
        if not api_key:
            raise ValueError("GEMINI_API_KEY not found in environment")
        
        genai.configure(api_key=api_key)
        self.model = genai.GenerativeModel(model)
    
    def extract_entities(self, chunk: str) -> Dict:
        """
        Extract entities from a clean chunk.
        
        Args:
            chunk: Cleaned text chunk
            
        Returns:
            Dictionary with extracted entities
        """
        prompt = f"""
Analyze this D&D campaign text and extract entities.

Text:
{chunk}

Return JSON with this exact structure:
{{
  "characters": [
    {{"name": "...", "description": "...", "confidence": 0.9}}
  ],
  "locations": [
    {{"name": "...", "description": "...", "confidence": 0.9}}
  ],
  "items": [
    {{"name": "...", "description": "...", "confidence": 0.9}}
  ],
  "factions": [
    {{"name": "...", "description": "...", "confidence": 0.9}}
  ],
  "relationships": [
    {{"entity1": "...", "relation": "...", "entity2": "...", "confidence": 0.9}}
  ]
}}

Confidence: 0.0-1.0 based on how explicit/clear the entity is.
Only return the JSON, no explanations.
"""
        
        try:
            response = self.model.generate_content(prompt)
            # Parse JSON from response
            json_text = response.text.strip()
            
            # Remove markdown code blocks if present
            if json_text.startswith('```'):
                json_text = json_text.split('```')[1]
                if json_text.startswith('json'):
                    json_text = json_text[4:]
                json_text = json_text.strip()
            
            entities = json.loads(json_text)
            return entities
            
        except json.JSONDecodeError as e:
            print(f"Failed to parse JSON: {e}")
            print(f"Raw response: {response.text}")
            return {}
        except Exception as e:
            print(f"Error during extraction: {e}")
            return {}
    
    def detect_contradictions(
        self, 
        entity_name: str, 
        descriptions: List[str]
    ) -> Optional[Dict]:
        """
        Detect contradictions in entity descriptions.
        
        Args:
            entity_name: Name of entity
            descriptions: List of descriptions from different sources
            
        Returns:
            Contradiction details or None
        """
        if len(descriptions) < 2:
            return None
        
        prompt = f"""
Analyze these descriptions of "{entity_name}" for contradictions.

Descriptions:
{chr(10).join(f"{i+1}. {desc}" for i, desc in enumerate(descriptions))}

Are there any contradictions? Consider:
- Physical descriptions
- Abilities/powers
- Relationships
- History/backstory
- Personality traits

Return JSON:
{{
  "has_contradiction": true/false,
  "type": "physical/ability/relationship/history/personality",
  "description": "Brief explanation",
  "severity": "minor/moderate/major",
  "conflicting_points": ["point 1", "point 2"]
}}

Only return JSON, no explanations.
"""
        
        try:
            response = self.model.generate_content(prompt)
            json_text = response.text.strip()
            
            # Clean markdown
            if json_text.startswith('```'):
                json_text = json_text.split('```')[1]
                if json_text.startswith('json'):
                    json_text = json_text[4:]
                json_text = json_text.strip()
            
            result = json.loads(json_text)
            
            if result.get('has_contradiction'):
                return result
            return None
            
        except Exception as e:
            print(f"Error detecting contradictions: {e}")
            return None


# Example usage
if __name__ == "__main__":
    analyzer = GeminiAnalyzer()
    
    # Test entity extraction
    test_chunk = """
    Thorin Ironforge, the master dwarven blacksmith of Hammerfall, 
    forged the legendary Hammer of Dawn in the volcanic fires of Mount Ashengale.
    The hammer was commissioned by King Baric III and later stolen by 
    the Shadow Syndicate during the Siege of Irongate.
    """
    
    print("=== Entity Extraction ===")
    entities = analyzer.extract_entities(test_chunk)
    print(json.dumps(entities, indent=2))
    
    # Test contradiction detection
    print("\n=== Contradiction Detection ===")
    descriptions = [
        "Thorin is a master blacksmith who crafted the Hammer of Dawn",
        "Thorin is a novice apprentice learning the trade"
    ]
    contradiction = analyzer.detect_contradictions("Thorin Ironforge", descriptions)
    if contradiction:
        print(json.dumps(contradiction, indent=2))
    else:
        print("No contradictions detected")
```

### Step 3: Create Pipeline Orchestrator

**File:** `src/lore_pipeline.py`

```python
"""
Complete lore processing pipeline: Ollama chunking → Gemini analysis → LMS storage.
"""
from typing import List, Dict
import time
from src.chunker import DocumentChunker
from src.gemini_analyzer import GeminiAnalyzer


class LorePipeline:
    """Orchestrates the two-layer processing pipeline."""
    
    def __init__(self):
        self.chunker = DocumentChunker()
        self.analyzer = GeminiAnalyzer()
    
    def process_document(
        self, 
        document: str,
        document_id: str
    ) -> Dict:
        """
        Process a complete campaign document through the pipeline.
        
        Args:
            document: Raw campaign text
            document_id: Unique identifier for tracking
            
        Returns:
            Processing results with extracted entities
        """
        print(f"Processing document: {document_id}")
        
        # Stage 1: Ollama Chunking (slow but free)
        print("  [1/3] Chunking with Ollama...")
        start = time.time()
        chunks = self.chunker.chunk_by_sessions(document)
        chunk_time = time.time() - start
        print(f"    → Created {len(chunks)} chunks in {chunk_time:.1f}s")
        
        # Stage 2: Gemini Analysis (fast but paid)
        print("  [2/3] Analyzing with Gemini...")
        all_entities = {
            'characters': [],
            'locations': [],
            'items': [],
            'factions': [],
            'relationships': []
        }
        
        total_tokens = 0
        
        for i, chunk in enumerate(chunks):
            print(f"    → Processing chunk {i+1}/{len(chunks)}...")
            
            # Extract entities
            entities = self.analyzer.extract_entities(chunk['content'])
            
            # Merge into master list
            for entity_type in all_entities.keys():
                if entity_type in entities:
                    all_entities[entity_type].extend(entities[entity_type])
            
            # Estimate token usage (rough: 1 token ≈ 4 chars)
            total_tokens += len(chunk['content']) // 4
            
            # Small delay to avoid rate limits
            time.sleep(0.5)
        
        analysis_time = time.time() - start - chunk_time
        print(f"    → Analyzed in {analysis_time:.1f}s")
        print(f"    → Estimated tokens: ~{total_tokens}")
        
        # Stage 3: Deduplication & Contradiction Detection
        print("  [3/3] Checking for contradictions...")
        contradictions = self._find_contradictions(all_entities)
        
        if contradictions:
            print(f"    ⚠ Found {len(contradictions)} potential contradictions")
        else:
            print(f"    ✓ No contradictions detected")
        
        return {
            'document_id': document_id,
            'entities': all_entities,
            'contradictions': contradictions,
            'stats': {
                'chunk_count': len(chunks),
                'chunk_time': chunk_time,
                'analysis_time': analysis_time,
                'total_time': time.time() - start,
                'estimated_tokens': total_tokens
            }
        }
    
    def _find_contradictions(self, entities: Dict) -> List[Dict]:
        """Find contradictions within extracted entities."""
        contradictions = []
        
        # Group characters by name
        character_groups = {}
        for char in entities.get('characters', []):
            name = char.get('name', '')
            if name not in character_groups:
                character_groups[name] = []
            character_groups[name].append(char.get('description', ''))
        
        # Check each character for contradictions
        for name, descriptions in character_groups.items():
            if len(descriptions) > 1:
                result = self.analyzer.detect_contradictions(name, descriptions)
                if result:
                    result['entity_name'] = name
                    result['entity_type'] = 'character'
                    contradictions.append(result)
        
        return contradictions


# Example usage
if __name__ == "__main__":
    pipeline = LorePipeline()
    
    # Test document
    test_doc = """
    Session 1: The Journey Begins
    
    The party meets Thorin Ironforge, a master dwarven blacksmith in the city of Hammerfall.
    He tells them about the legendary Hammer of Dawn, which he forged in Mount Ashengale
    for King Baric III. The hammer was stolen by the Shadow Syndicate during the Siege
    of Irongate five years ago.
    
    Thorin agrees to help the party track down the hammer if they can prove themselves
    by clearing out the goblin infestation in the nearby Whispering Caves.
    """
    
