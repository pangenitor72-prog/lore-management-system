### Step 1: Create Chunker Module

**File:** `src/chunker.py`

```python
"""
Document chunking using Ollama for preprocessing.
Breaks large documents into manageable chunks for Gemini analysis.
"""
import ollama
from typing import List, Dict
import re


class DocumentChunker:
    """Chunks documents using local Ollama model."""
    
    def __init__(self, model: str = "llama3.1:8b"):
        self.model = model
        self.client = ollama.Client()
    
    def chunk_by_sessions(self, document: str) -> List[Dict[str, str]]:
        """
        Split a campaign document into session-based chunks.
        
        Args:
            document: Raw campaign text
            
        Returns:
            List of chunks with metadata
        """
        prompt = f"""
Split this campaign document into separate sessions. 
For each session, extract:
1. Session number/title
2. Main events
3. Characters involved

Document:
{document[:2000]}  # Send first 2000 chars as example

Format each chunk as:
SESSION: [number]
EVENTS: [brief summary]
CHARACTERS: [list]
---
"""
        
        response = self.client.chat(
            model=self.model,
            messages=[
                {
                    "role": "system",
                    "content": "You are a document chunking assistant. Be concise and structured."
                },
                {"role": "user", "content": prompt}
            ]
        )
        
        # Parse response into chunks
        raw_chunks = response['message']['content'].split('---')
        
        chunks = []
        for i, chunk in enumerate(raw_chunks):
            if chunk.strip():
                chunks.append({
                    'chunk_id': f"chunk_{i}",
                    'content': chunk.strip(),
                    'metadata': self._extract_metadata(chunk)
                })
        
        return chunks
    
    def _extract_metadata(self, chunk: str) -> Dict[str, str]:
        """Extract metadata from chunk header."""
        metadata = {}
        
        # Extract session number
        session_match = re.search(r'SESSION:\s*(.+)', chunk)
        if session_match:
            metadata['session'] = session_match.group(1).strip()
        
        return metadata
    
    def clean_formatting(self, text: str) -> str:
        """
        Remove formatting junk from text.
        
        Args:
            text: Raw text with timestamps, metadata, etc.
            
        Returns:
            Cleaned text
        """
        prompt = f"""
Remove all timestamps, user tags, and formatting from this text.
Keep only the actual narrative content.

Text:
{text[:1000]}

Return only the cleaned text, no explanations.
"""
        
        response = self.client.chat(
            model=self.model,
            messages=[{"role": "user", "content": prompt}]
        )
        
        return response['message']['content']


# Example usage
if __name__ == "__main__":
    chunker = DocumentChunker()
    
    # Test document
    test_doc = """
[2024-01-15 19:30] DM: The party arrives at Ironforge
[2024-01-15 19:32] Player1: I want to talk to Thorin
[2024-01-15 19:35] DM: Thorin Ironforge greets you at his smithy.
He shows you the legendary Hammer of Dawn.
[2024-01-15 19:40] Player2: Can we examine it?
"""
    
    # Clean formatting
    clean = chunker.clean_formatting(test_doc)
    print("Cleaned text:")
    print(clean)
```

