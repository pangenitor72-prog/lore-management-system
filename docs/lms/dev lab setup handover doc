"""Agent base classes and interfaces."""
from abc import ABC, abstractmethod
from typing import Any, Optional
import ollama


class BaseAgent(ABC):
    """Base class for all agents."""
    
    def __init__(self, name: str, model: str = "llama3.1:8b"):
        self.name = name
        self.model = model
        self.client = ollama.Client()
    
    @abstractmethod
    def process(self, input_data: Any) -> Any:
        """Process input and return result."""
        pass
    
    def generate(self, prompt: str, system: Optional[str] = None) -> str:
        """Generate response using local model."""
        messages = []
        
        if system:
            messages.append({"role": "system", "content": system})
        
        messages.append({"role": "user", "content": prompt})
        
        response = self.client.chat(
            model=self.model,
            messages=messages
        )
        
        return response['message']['content']


class ScribeAgent(BaseAgent):
    """Agent for documentation and logging."""
    
    def __init__(self):
        super().__init__(name="Scribe", model="llama3.1:8b")
    
    def process(self, input_data: str) -> str:
        """Generate documentation for given input."""
        system = "You are a technical documentation specialist. Create clear, concise documentation."
        return self.generate(input_data, system=system)
```

