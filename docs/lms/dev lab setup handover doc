"""
Abominable Orchestrator - Core Module
Command interpreter and agent coordinator
"""
from typing import Optional
import logging

logger = logging.getLogger(__name__)


class Orchestrator:
    """Main orchestrator for coordinating AI agents."""
    
    def __init__(self):
        self.agents = {}
        logger.info("Orchestrator initialized")
    
    def register_agent(self, name: str, agent) -> None:
        """Register a new agent with the orchestrator."""
        self.agents[name] = agent
        logger.info(f"Agent registered: {name}")
    
    def execute_command(self, command: str) -> Optional[str]:
        """Execute a command and route to appropriate agent."""
        logger.debug(f"Executing command: {command}")
        
        if command.lower() == "status":
            return self._get_status()
        
        return None
    
    def _get_status(self) -> str:
        """Get orchestrator status."""
        return f"Orchestrator active. Agents: {len(self.agents)}"


if __name__ == "__main__":
    # Basic test
    orch = Orchestrator()
    print(orch.execute_command("status"))
```

