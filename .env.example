# Lore Management System - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================================
# REQUIRED: API Keys
# ============================================================

# Google Gemini API Key (required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Google API Key (can be used instead of GEMINI_API_KEY)
# GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# REQUIRED: Neo4j Database
# ============================================================

# Neo4j connection URI
NEO4J_URI=bolt://localhost:7687

# Neo4j username (default: neo4j)
NEO4J_USER=neo4j

# Neo4j password
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================
# OPTIONAL: Feature Flags
# ============================================================

# Enable Arc Engine (narrative structure and pacing system)
# Set to "true" to enable, "false" to disable (default: false)
# The Arc Engine provides story phase tracking, tension management,
# and episode pacing based on Campbell's Hero's Journey.
ENABLE_ARC_ENGINE=false

# Enable worldbuilding consistency rules
# Set to "false" to disable worldbuilding rules enforcement (default: true)
# ENABLE_WORLDBUILDING_RULES=true

# ============================================================
# OPTIONAL: Admin Configuration
# ============================================================

# Admin panel PIN (default: 1234)
# Change this to secure your admin panel
# ADMIN_PIN=1234

# ============================================================
# OPTIONAL: Email Notifications
# ============================================================

# Resend API Key (for email update notifications)
# RESEND_API_KEY=your_resend_api_key_here

# From email address for notifications
# RESEND_FROM_EMAIL=Mantle <onboarding@resend.dev>

# ============================================================
# OPTIONAL: Environment
# ============================================================

# Application environment (development, production)
# LMS_ENV=development

# API secret key (for production deployments)
# API_SECRET_KEY=your_secret_key_here
