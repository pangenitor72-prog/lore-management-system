# .env.production.template
#
# ⚠️ SECURITY WARNING ⚠️
# This file contains PLACEHOLDER values only.
# NEVER commit actual credentials to version control.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env (or .env.production)
# 2. Replace ALL placeholder values with your actual credentials
# 3. Ensure .env is in .gitignore (it is by default)
# 4. Keep your credentials secure and never share them

# Neo4j Database
# For Neo4j Aura, use: neo4j+s://your-instance.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here

# API Security
# Generate a strong random key (minimum 32 characters)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=your_secure_api_secret_key_here_minimum_32_chars
LMS_ENV=production

# External Services
# Google Gemini API key for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Service (if using separate service)
EMBEDDING_API_KEY=your_embedding_api_key_here

# SSL Configuration (optional for production)
SSL_CERT_PATH=/etc/letsencrypt/live/your_domain/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your_domain/privkey.pem
