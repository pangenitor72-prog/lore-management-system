# .env.production.template
# SECURITY: Example values only. Never place real secrets in tracked files.
# Credentials previously committed here must be rotated separately.
#
# This file contains the environment variables for the LMS application.
# Copy this file to .env.production and fill in the values.
#
# Do not commit the .env.production file to version control.

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# API
API_SECRET_KEY=CHANGE_ME_API_SECRET_KEY
LMS_ENV=production

# External Services
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY

# SSL
SSL_CERT_PATH=/etc/letsencrypt/live/your_domain/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your_domain/privkey.pem

# Feature Flags
# Enable Arc Engine (narrative structure and pacing system)
# Set to "true" to enable, "false" to disable (default: false)
ENABLE_ARC_ENGINE=false

